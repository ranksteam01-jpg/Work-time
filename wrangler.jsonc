{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "attendance-web-v1",
  "main": "./src/index.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "attendance-web-v1",
      "database_id": "PASTE_D1_DATABASE_ID_HERE",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ATTENDANCE_TIMEZONE": "Asia/Bangkok",
    "ATTENDANCE_SESSION_HOURS": "168"
  }
}
