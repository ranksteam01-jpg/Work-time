# Required. Choose a strong private password.
ATTENDANCE_PASSWORD=change-this-password

# Required. Use a random string of at least 32 characters.
# Example generation: python -c "import secrets; print(secrets.token_urlsafe(48))"
ATTENDANCE_SECRET=replace-with-a-long-random-secret

# Optional
ATTENDANCE_TIMEZONE=Asia/Bangkok
ATTENDANCE_DB=./data/attendance.db
ATTENDANCE_SESSION_HOURS=168
ATTENDANCE_SECURE_COOKIE=0
HOST=0.0.0.0
PORT=8080
